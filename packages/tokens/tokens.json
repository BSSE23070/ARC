  "color": {
    "primitive": {
      "signal": { "$value": "#FF4314", "$type": "color", "$description": "Primary: the logo, CTAs, urgency" },
      "ink": { "$value": "#000000", "$type": "color", "$description": "Foundation: type, surfaces" },
      "paper": { "$value": "#FFFFFF", "$type": "color", "$description": "Foundation: space, cards" },
      "meet": { "$value": "#0055F5", "$type": "color", "$description": "Accent: matching, maps, trust" },
      "spark": { "$value": "#F47FDF", "$type": "color", "$description": "Accent: social, invites, joy" },
      "volt": { "$value": "#E2FF0F", "$type": "color", "$description": "Accent: verified, live, now" },
      "gray900": { "$value": "#181818", "$type": "color" },
      "gray800": { "$value": "#262626", "$type": "color" },
      "gray500": { "$value": "#9A9A9A", "$type": "color" },
      "slate900": { "$value": "#15171A", "$type": "color" },
      "slate600": { "$value": "#3A3D42", "$type": "color" }
