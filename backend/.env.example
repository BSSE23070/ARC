# Copy to backend/.env for local development. Never commit the real .env.
# Every setting and its default is documented in arc/core/config.py.

ARC_ENV=dev
ARC_DATABASE_URL=postgresql+asyncpg://arc:arc@localhost:5432/arc
ARC_REDIS_URL=redis://localhost:6379/0

# Sign-in codes: "smtp" sends to Mailpit (http://localhost:8025) when you run
# docker compose; "console" prints the code in the API log instead.
ARC_EMAIL_BACKEND=smtp
ARC_SMTP_HOST=localhost
ARC_SMTP_PORT=1025

# Required in production (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
# ARC_JWT_SECRET=
